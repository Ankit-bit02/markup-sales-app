@page "/change-password"
@using System.ComponentModel.DataAnnotations
@inject ApiClient Api
@inject AuthSession Auth
@inject NavigationManager Nav
@inject ToastService Toast

<PageTitle>Change password - MARK_UP</PageTitle>

@if (Auth.MustChangePassword)
{
    <div class="auth-wrap">
        <div class="auth-card">
            <div class="auth-brand">
                <img src="icons/icon-192.png" alt="" />
                <h1>Set your password</h1>
                <p>For security, choose your own password before continuing.</p>
            </div>
            @Form
        </div>
    </div>
}
else
{
    <PageHeader Title="Change password" Subtitle="Update the password you use to sign in." IconName="key" />
    <div class="card" style="max-width:520px">
        <div class="card-body">
            @Form
        </div>
    </div>
}

@code {
    private sealed class PasswordForm
    {
        [Required(ErrorMessage = "Enter your current password.")]
        public string Current { get; set; } = "";

        [Required(ErrorMessage = "Enter a new password.")]
        [StringLength(100, MinimumLength = 8, ErrorMessage = "New password must be at least 8 characters.")]
        public string New { get; set; } = "";

        [Required(ErrorMessage = "Repeat the new password.")]
        [Compare(nameof(New), ErrorMessage = "The new passwords do not match.")]
        public string Confirm { get; set; } = "";
    }

    private readonly PasswordForm form = new();
    private string? error;
    private bool busy;

    private bool LengthOk => form.New.Length >= 8;
    private bool LetterOk => form.New.Any(char.IsLetter);
    private bool DigitOk => form.New.Any(char.IsDigit);
    private bool MatchOk => form.New.Length > 0 && form.New == form.Confirm;

    private RenderFragment Form => __builder =>
    {
        <Alert Kind="error" Message="@error" />
        <EditForm Model="form" OnValidSubmit="SaveAsync">
            <DataAnnotationsValidator />
            <div class="stack">
                <label class="field">
                    <span class="field-label req">Current password</span>
                    <InputText type="password" @bind-Value="form.Current" autocomplete="current-password" />
                    <ValidationMessage For="() => form.Current" />
                </label>
                <label class="field">
                    <span class="field-label req">New password</span>
                    <input type="password" @bind="form.New" @bind:event="oninput" autocomplete="new-password" />
                    <ValidationMessage For="() => form.New" />
                </label>
                <label class="field">
                    <span class="field-label req">Repeat new password</span>
                    <input type="password" @bind="form.Confirm" @bind:event="oninput" autocomplete="new-password" />
                    <ValidationMessage For="() => form.Confirm" />
                </label>
                <ul class="pw-rules">
                    <li class='@(LengthOk ? "ok" : "")'><Icon Name='@(LengthOk ? "check-circle" : "circle")' Class="sm" /> At least 8 characters</li>
                    <li class='@(LetterOk ? "ok" : "")'><Icon Name='@(LetterOk ? "check-circle" : "circle")' Class="sm" /> At least one letter</li>
                    <li class='@(DigitOk ? "ok" : "")'><Icon Name='@(DigitOk ? "check-circle" : "circle")' Class="sm" /> At least one number</li>
                    <li class='@(MatchOk ? "ok" : "")'><Icon Name='@(MatchOk ? "check-circle" : "circle")' Class="sm" /> Both new passwords match</li>
                </ul>
                <div class="actions">
                    <button type="submit" class="btn btn-primary" disabled="@busy">
                        @if (busy)
                        {
                            <span class="spinner"></span>
                        }
                        else
                        {
                            <Icon Name="check" />
                        }
                        <span>Save password</span>
                    </button>
                    @if (!Auth.MustChangePassword)
                    {
                        <a class="btn" href="">Cancel</a>
                    }
                </div>
            </div>
        </EditForm>
    };

    protected override void OnInitialized()
    {
        if (!Auth.IsLoggedIn) Nav.NavigateTo("login", replace: true);
    }

    private async Task SaveAsync()
    {
        if (!LengthOk || !LetterOk || !DigitOk)
        {
            error = "The new password must have at least 8 characters, a letter and a number.";
            return;
        }

        busy = true;
        error = null;
        try
        {
            var res = await Api.PostAsync<LoginResponse>("api/auth/change-password",
                new ChangePasswordRequest { CurrentPassword = form.Current, NewPassword = form.New });
            var wasForced = Auth.MustChangePassword;
            await Auth.SetAsync(res);
            form.Current = form.New = form.Confirm = "";
            Toast.Success("Your password has been changed.", "Password updated");
            if (wasForced) Nav.NavigateTo(Auth.HomePath, replace: true);
        }
        catch (ApiException ex)
        {
            error = ex.Message;
        }
        finally
        {
            busy = false;
        }
    }
}