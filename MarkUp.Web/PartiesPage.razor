@page "/admin/parties"
@inject ApiClient Api
@inject AuthSession Auth
@inject ToastService Toast

<PageTitle>Parties - MARK_UP</PageTitle>

<RoleGuard Allow="@Roles.Admin">
    <PageHeader Title="Parties" Subtitle="Shops on each beat. Salespeople see the parties of their own beats." IconName="store" />

    <Alert Kind="error" Message="@error" />
    @if (loaded && partyTypes.Count(t => t.IsActive) == 0)
    {
        <Alert Kind="warning" Title="Add party types first">Every party needs a type (e.g. Retailer). <a href="admin/settings">Go to Master Settings</a>.</Alert>
    }
    else if (loaded && beats.Count(b => b.IsActive) == 0)
    {
        <Alert Kind="warning" Title="Add a beat first">Every party belongs to a beat. <a href="admin/beats">Go to Beats</a>.</Alert>
    }

    @if (ReviewCount > 0)
    {
        <Alert Kind="info" Title='@($"{ReviewCount} new shop(s) added by salespeople")'>
            Check the name, type, contact and location, edit if needed, then click <b>Mark as checked</b>. Deactivate duplicates.
        </Alert>
    }
    <div class="import-filters">
        <button type="button" class='chip @(reviewOnly ? "" : "active")' @onclick="() => { reviewOnly = false; }">All parties <b>@parties.Count(p => p.IsActive)</b></button>
        <button type="button" class='chip chip-info @(reviewOnly ? "active" : "")' @onclick="() => { reviewOnly = true; }">Needs review <b>@ReviewCount</b></button>
    </div>

    <MasterList @ref="list" TItem="Party" Title='@(reviewOnly ? "Shops to review" : "All parties")' ItemName="party" ItemNamePlural="parties" IconName="store"
                ApiPath="api/masters/parties"
                Filter="@(p => !reviewOnly || p.NeedsReview)"
                OnLoaded="OnPartiesLoaded"
                SearchText='@(p => $"{p.Name} {p.ContactPerson} {p.Phone} {p.Address} {BeatName(p.BeatId)}")'
                Sort="@(l => l.OrderBy(p => BeatName(p.BeatId)).ThenBy(p => p.Name))">
        <HeaderCells>
            <th>Party</th>
            <th>Beat</th>
            <th>Type</th>
            <th>Contact</th>
            <th>Address</th>
            <th>GPS</th>
        </HeaderCells>
        <RowCells Context="p">
            <td>
                <div class="cell-title">
                    @p.Name
                    @if (p.NeedsReview)
                    {
                        <span class="badge badge-info no-dot">New</span>
                    }
                </div>
                @if (!string.IsNullOrEmpty(p.AddedByUserId))
                {
                    <div class="cell-sub">Added by @UserName(p.AddedByUserId)@(p.AddedAt is { } at ? " · " + at.ToString("yyyy-MM-dd HH:mm") : "")</div>
                }
            </td>
            <td>@BeatName(p.BeatId)</td>
            <td><span class="badge badge-info no-dot">@TypeName(p.PartyTypeId)</span></td>
            <td>
                @p.ContactPerson
                @if (!string.IsNullOrWhiteSpace(p.Phone))
                {
                    <div class="cell-sub">@p.Phone</div>
                }
            </td>
            <td>@p.Address</td>
            <td>
                @if (p.Lat != null && p.Lng != null)
                {
                    <a class="badge badge-success no-dot" href="@Fmt.MapLink(p.Lat.Value, p.Lng.Value)" target="_blank" rel="noopener" title="Open in Google Maps">GPS <Icon Name="external" Class="sm" /></a>
                }
                else
                {
                    <span class="badge badge-muted no-dot" title="Saved automatically at the first visit">Not yet</span>
                }
            </td>
        </RowCells>
        <RowActions Context="p">
            @if (p.NeedsReview)
            {
                <button class="btn btn-sm btn-success" title="The shop details are correct" disabled="@(checkingId == p.Id)" @onclick="() => MarkCheckedAsync(p)">
                    @if (checkingId == p.Id)
                    {
                        <span class="spinner"></span>
                    }
                    else
                    {
                        <Icon Name="check" Class="sm" />
                    }
                    <span>Mark as checked</span>
                </button>
            }
        </RowActions>
        <FormFields Context="p">
            <label class="field full">
                <span class="field-label req">Party name</span>
                <InputText @bind-Value="p.Name" placeholder="e.g. Ram Kirana Store" />
                <ValidationMessage For="() => p.Name" />
            </label>
            <label class="field">
                <span class="field-label req">Beat</span>
                <InputSelect @bind-Value="p.BeatId">
                    <option value="">Select beat</option>
                    @foreach (var b in beats.Where(x => x.IsActive || x.Id == p.BeatId))
                    {
                        <option value="@b.Id">@b.Name</option>
                    }
                </InputSelect>
                <ValidationMessage For="() => p.BeatId" />
            </label>
            <label class="field">
                <span class="field-label req">Party type</span>
                <InputSelect @bind-Value="p.PartyTypeId">
                    <option value="">Select type</option>
                    @foreach (var t in partyTypes.Where(x => x.IsActive || x.Id == p.PartyTypeId))
                    {
                        <option value="@t.Id">@t.Name</option>
                    }
                </InputSelect>
                <ValidationMessage For="() => p.PartyTypeId" />
            </label>
            <label class="field">
                <span class="field-label">Contact person</span>
                <InputText @bind-Value="p.ContactPerson" />
            </label>
            <label class="field">
                <span class="field-label">Contact number</span>
                <InputText @bind-Value="p.Phone" inputmode="tel" placeholder="98XXXXXXXX" />
                <ValidationMessage For="() => p.Phone" />
            </label>
            <label class="field full">
                <span class="field-label">Address</span>
                <InputText @bind-Value="p.Address" />
            </label>
            <div class="section-title full">Shop location (GPS)</div>
            <label class="field">
                <span class="field-label">Latitude</span>
                <InputNumber @bind-Value="p.Lat" step="any" placeholder="e.g. 27.717245" />
                <ValidationMessage For="() => p.Lat" />
            </label>
            <label class="field">
                <span class="field-label">Longitude</span>
                <InputNumber @bind-Value="p.Lng" step="any" placeholder="e.g. 85.323961" />
                <ValidationMessage For="() => p.Lng" />
            </label>
            @if (!string.IsNullOrEmpty(p.AddedByUserId))
            {
                <label class="check full"><InputCheckbox @bind-Value="p.NeedsReview" /> Needs review (added by @UserName(p.AddedByUserId))</label>
            }
            <span class="hint full">
                Filled automatically at the shop's first visit. To correct it: in Google Maps, long-press the shop,
                copy the two numbers shown (latitude, longitude) and paste them here. Leave both empty to capture it again at the next visit.
            </span>
        </FormFields>
    </MasterList>
</RoleGuard>

@code {
    private List<Beat> beats = new();
    private List<PartyType> partyTypes = new();
    private List<UserDto> users = new();
    private List<Party> parties = new();
    private MasterList<Party>? list;
    private bool reviewOnly;
    private string? checkingId;

    private int ReviewCount => parties.Count(p => p.IsActive && p.NeedsReview);
    private string UserName(string id) => users.FirstOrDefault(u => u.Id == id)?.Name ?? "a salesperson";

    private void OnPartiesLoaded(List<Party> loaded) => parties = loaded;

    private async Task MarkCheckedAsync(Party p)
    {
        checkingId = p.Id;
        try
        {
            var json = System.Text.Json.JsonSerializer.Serialize(p);
            var copy = System.Text.Json.JsonSerializer.Deserialize<Party>(json)!;
            copy.NeedsReview = false;
            await Api.PutAsync<Party>($"api/masters/parties/{Uri.EscapeDataString(p.Id)}", copy);
            Toast.Success($"{p.Name} is marked as checked.");
            if (list != null) await list.LoadAsync();
        }
        catch (ApiException ex)
        {
            Toast.Error(ex.Message, "Could not update");
        }
        finally
        {
            checkingId = null;
        }
    }
    private string? error;
    private bool loaded;

    private string BeatName(string id) => beats.FirstOrDefault(b => b.Id == id)?.Name ?? "";
    private string TypeName(string id) => partyTypes.FirstOrDefault(t => t.Id == id)?.Name ?? "";

    protected override async Task OnInitializedAsync()
    {
        if (!Auth.IsInRole(Roles.Admin)) return;
        try
        {
            beats = await Api.GetAsync<List<Beat>>("api/masters/beats");
            partyTypes = await Api.GetAsync<List<PartyType>>("api/masters/party-types");
            users = await Api.GetAsync<List<UserDto>>("api/users");
            loaded = true;
        }
        catch (ApiException ex)
        {
            error = ex.Message;
        }
    }
}