@page "/sales"
@implements IDisposable
@inject ApiClient Api
@inject OfflineSync Sync
@inject Browser Browser
@inject AuthSession Auth
@inject ToastService Toast
@inject ConfirmService Confirm
@inject TrackingClient Tracking

<PageTitle>Market Visit - MARK_UP</PageTitle>

<RoleGuard Allow="@Roles.Sales">
    <PageHeader Title="Market Visit" Subtitle="@SubtitleText" IconName="map-pin">
        <Actions>
            <span class="badge badge-info no-dot"><Icon Name="calendar" Class="sm" /> @Fmt.Date(Fmt.Today()), @Fmt.Today().DayOfWeek</span>
        </Actions>
    </PageHeader>

    <Alert Kind="error" Title="Could not load your data" Message="@loadError" />
    @if (offlineData)
    {
        <Alert Kind="warning" Title="Working offline">Using beats, parties and products saved on this phone. Visits will be sent when you are back online.</Alert>
    }

    @* ---------------- Attendance ---------------- *@
    <div class="card">
        <div class="status-card">
            @if (attOk)
            {
                <span class="status-icon ok"><Icon Name="check-circle" Class="lg" /></span>
                <div class="status-text">
                    <b>Attendance marked</b>
                    <span>@attStatus</span>
                </div>
            }
            else if (attBusy)
            {
                <span class="status-icon info"><span class="spinner"></span></span>
                <div class="status-text">
                    <b>Marking attendance...</b>
                    <span>Getting your location. Please wait.</span>
                </div>
            }
            else
            {
                <span class="status-icon wait"><Icon Name="clock" Class="lg" /></span>
                <div class="status-text">
                    <b>Attendance not marked</b>
                    <span>Turn on location (GPS) and tap the button. Visits can be saved after attendance.</span>
                </div>
                <button class="btn btn-primary" @onclick="CaptureAttendanceAsync"><Icon Name="map-pin" /> Mark attendance</button>
            }
        </div>
        @if (!string.IsNullOrEmpty(attError))
        {
            <div style="padding:0 18px 4px">
                <Alert Kind="error" Message="@attError" />
            </div>
        }
    </div>

    @* ---------------- New party (shop) ---------------- *@
    @if (newParty != null && boot != null)
    {
        <div class="modal-backdrop">
            <div class="modal" role="dialog" aria-modal="true">
                <EditForm Model="newParty" OnValidSubmit="SaveNewPartyAsync">
                    <DataAnnotationsValidator />
                    <div class="modal-header">
                        <h2>New party</h2>
                        <button type="button" class="btn btn-ghost btn-icon" aria-label="Close" @onclick="CloseNewParty"><Icon Name="x" /></button>
                    </div>
                    <div class="modal-body">
                        <Alert Kind="info" Class="compact">The shop is added to <b>@BeatName(newParty.BeatId)</b> and can be used straight away. The office will check it later.</Alert>
                        <Alert Kind="error" Message="@partyError" />
                        @if (dupWarning)
                        {
                            <Alert Kind="warning" Class="compact" Title="Same name already on this beat">Check the list first. If it really is a different shop, tap <b>Add anyway</b>.</Alert>
                        }
                        <ValidationSummary />
                        <div class="form-grid cols-2">
                            <label class="field full">
                                <span class="field-label req">Shop name</span>
                                <InputText @bind-Value="newParty.Name" placeholder="e.g. Sagar Kirana Pasal" />
                                <ValidationMessage For="() => newParty.Name" />
                            </label>
                            <label class="field">
                                <span class="field-label req">Party type</span>
                                <InputSelect @bind-Value="newParty.PartyTypeId">
                                    <option value="">Select type</option>
                                    @foreach (var t in boot.PartyTypes)
                                    {
                                        <option value="@t.Id">@t.Name</option>
                                    }
                                </InputSelect>
                                <ValidationMessage For="() => newParty.PartyTypeId" />
                            </label>
                            <label class="field">
                                <span class="field-label">Contact person</span>
                                <InputText @bind-Value="newParty.ContactPerson" />
                            </label>
                            <label class="field">
                                <span class="field-label">Contact number</span>
                                <InputText @bind-Value="newParty.Phone" inputmode="tel" placeholder="98XXXXXXXX" />
                                <ValidationMessage For="() => newParty.Phone" />
                            </label>
                            <label class="field">
                                <span class="field-label">Address</span>
                                <InputText @bind-Value="newParty.Address" placeholder="Tole / area" />
                            </label>
                        </div>
                        <p class="muted small mt-2 mb-0">
                            Stand at the shop when adding it: its GPS location is saved from your phone.
                            @if (boot.VisitRadiusM > 0)
                            {
                                <text>Orders for this shop can then only be taken within @boot.VisitRadiusM m of it.</text>
                            }
                        </p>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn" disabled="@partyBusy" @onclick="CloseNewParty">Cancel</button>
                        <button type="submit" class="btn btn-primary" disabled="@partyBusy">
                            @if (partyBusy)
                            {
                                <span class="spinner"></span>
                            }
                            else
                            {
                                <Icon Name="check" />
                            }
                            <span>@(dupWarning ? "Add anyway" : "Add party")</span>
                        </button>
                    </div>
                </EditForm>
            </div>
        </div>
    }

    @* ---------------- Beat tracking ---------------- *@
    @if (attOk && boot != null && boot.Beats.Count > 0)
    {
        <div class='card track-card @(Tracking.IsTracking ? "on" : "")'>
            <div class="status-card">
                @if (Tracking.IsTracking)
                {
                    <span class="status-icon ok"><span class="pulse-dot"></span></span>
                    <div class="status-text">
                        <b>Beat tracking is on</b>
                        <span>
                            Since @(Tracking.StartedAt?.ToString("HH:mm")) · last point @(Tracking.LastPointAt?.ToString("HH:mm") ?? "–")
                            @if (Tracking.Waiting > 0)
                            {
                                <text> · @Tracking.Waiting waiting to send</text>
                            }
                        </span>
                    </div>
                    <button class="btn btn-outline-danger" disabled="@trackBusy" @onclick="EndBeatAsync"><Icon Name="x-circle" /> End beat</button>
                }
                else
                {
                    <span class="status-icon info"><Icon Name="route" Class="lg" /></span>
                    <div class="status-text">
                        <b>Start your beat</b>
                        <span>Your route is recorded while this app is open, until you tap End beat.</span>
                    </div>
                    <button class="btn btn-primary" disabled="@trackBusy" @onclick="StartBeatAsync">
                        @if (trackBusy)
                        {
                            <span class="spinner"></span>
                        }
                        else
                        {
                            <Icon Name="route" />
                        }
                        <span>Start beat</span>
                    </button>
                }
            </div>
            @if (Tracking.IsTracking)
            {
                <div style="padding:0 18px 14px">
                    <Alert Kind="warning" Class="compact" Message="@Tracking.LastError" />
                    <Alert Kind="info" Class="compact mb-0">
                        Keep this app open on screen. Tracking pauses when the phone is locked or you switch to another app.
                        @if (!Tracking.WakeLockOk)
                        {
                            <b> This phone cannot keep the screen on by itself; turn off auto screen lock during your beat.</b>
                        }
                    </Alert>
                </div>
            }
        </div>
    }

    @* ---------------- Orders ready to share ---------------- *@
    @foreach (var r in results.Where(r => r.Productive))
    {
        <div class="card share-card" @key="r.VisitId">
            <span class="status-icon ok"><Icon Name="check-circle" Class="lg" /></span>
            <div class="share-text">
                <b>Order @r.OrderNo saved</b>
                <span>@r.PartyName &middot; NPR @Fmt.Money(r.TotalValue)</span>
            </div>
            <button class="btn btn-whatsapp" @onclick="() => ShareAsync(r)"><Icon Name="message" /> Share on WhatsApp</button>
            <button class="btn btn-ghost btn-sm" @onclick="() => DismissAsync(r)">Done</button>
        </div>
    }

    @* ---------------- Records waiting to send ---------------- *@
    @if (queue.Count > 0)
    {
        <div class="card">
            <div class="card-header">
                <h3><Icon Name="upload" /> Waiting to send</h3>
                <span class="count">@queue.Count</span>
                <span class="spacer"></span>
                <button class="btn btn-sm" disabled="@Sync.IsSyncing" @onclick="SyncNowAsync">
                    @if (Sync.IsSyncing)
                    {
                        <span class="spinner"></span>
                        <span>Sending...</span>
                    }
                    else
                    {
                        <Icon Name="send" Class="sm" />
                        <span>Send now</span>
                    }
                </button>
            </div>
            <div class="card-body">
                @if (!string.IsNullOrEmpty(Sync.LastMessage))
                {
                    <Alert Kind="warning" Class="compact" Message="@Sync.LastMessage" />
                }
                @foreach (var q in queue)
                {
                    <div class="queue-item" @key="q.Id">
                        <span class='status-icon @(string.IsNullOrEmpty(q.Error) ? "wait" : "err")' style="width:32px;height:32px">
                            <Icon Name='@(string.IsNullOrEmpty(q.Error) ? "clock" : "alert")' Class="sm" />
                        </span>
                        <div class="q-text">
                            <div>@q.Label</div>
                            <small>Saved @(q.CreatedAt.ToString("yyyy-MM-dd HH:mm"))</small>
                            @if (!string.IsNullOrEmpty(q.Error))
                            {
                                <Alert Kind="error" Class="compact mt-1" Title="Not accepted" Message="@q.Error" />
                                <div class="actions">
                                    <button class="btn btn-sm" @onclick="() => RetryAsync(q.Id)"><Icon Name="refresh" Class="sm" /> Try again</button>
                                    <button class="btn btn-sm btn-outline-danger" @onclick="() => RemoveQueuedAsync(q)"><Icon Name="trash" Class="sm" /> Remove</button>
                                </div>
                            }
                        </div>
                    </div>
                }
            </div>
        </div>
    }

    @* ---------------- Visit form ---------------- *@
    @if (boot != null)
    {
        <div class="card">
            <div class="card-header">
                <h3><Icon Name="store" /> Visit details</h3>
            </div>
            <div class="card-body">
                @if (boot.Beats.Count == 0)
                {
                    <Alert Kind="warning" Title="No beat assigned">Ask your administrator to assign a beat to you.</Alert>
                }
                <div class="form-grid cols-2">
                    <div class="field">
                        <span class="field-label req">Beat</span>
                        @if (boot.Beats.Count == 1)
                        {
                            <input value="@boot.Beats[0].Name" readonly />
                        }
                        else
                        {
                            <select @bind="beatId" @bind:after="OnBeatChanged" disabled="@(boot.Beats.Count == 0)">
                                <option value="">Select today's beat</option>
                                @foreach (var b in boot.Beats)
                                {
                                    <option value="@b.Id">@b.Name</option>
                                }
                            </select>
                        }
                    </div>
                    <div class="field">
                        <span class="field-label req">Party</span>
                        <div class="row" style="flex-wrap:nowrap;gap:8px">
                            <select @bind="partyId" disabled="@(string.IsNullOrEmpty(beatId))" style="flex:1;min-width:0">
                                <option value="">@(string.IsNullOrEmpty(beatId) ? "Select a beat first" : "Select party")</option>
                                @foreach (var p in PartiesInBeat)
                                {
                                    <option value="@p.Id">@p.Name@(p.NeedsReview ? " (new)" : "")</option>
                                }
                            </select>
                            <button type="button" class="btn" title="Add a new shop" disabled="@(string.IsNullOrEmpty(beatId))" @onclick="OpenNewParty">
                                <Icon Name="plus" /> <span>New</span>
                            </button>
                        </div>
                    </div>
                    @if (SelectedParty != null)
                    {
                        <div class="party-info full">
                            <Icon Name="map-pin" Class="sm" />
                            <div>
                                <b>@SelectedParty.Name</b>
                                @if (!string.IsNullOrWhiteSpace(SelectedParty.Address))
                                {
                                    <div>@SelectedParty.Address</div>
                                }
                                @if (!string.IsNullOrWhiteSpace(SelectedParty.ContactPerson) || !string.IsNullOrWhiteSpace(SelectedParty.Phone))
                                {
                                    <div class="muted">@SelectedParty.ContactPerson @SelectedParty.Phone</div>
                                }
                                @if (boot.VisitRadiusM > 0)
                                {
                                    <div class="muted small">
                                        @(SelectedParty.Lat == null ? "Shop location not saved yet: it is saved with this visit." : $"Save the visit within {boot.VisitRadiusM} m of the shop.")
                                    </div>
                                }
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>

        <div class="card">
            <div class="card-header">
                <h3><Icon Name="cart" /> Order</h3>
                @if (lines.Count > 0)
                {
                    <span class="count">@lines.Count item(s)</span>
                }
            </div>
            <div class="card-body">
                @for (var i = 0; i < lines.Count; i++)
                {
                    var line = lines[i];
                    var product = ProductOf(line);
                    if (product == null) continue;
                    var calc = Calc(line, product);
                    var schemes = SchemesFor(product);
                    <div class="line-item" @key="line">
                        <div class="line-item-head">
                            <div class="name">
                                <b>@product.Name</b>
                                <small>@product.Code &middot; RT @Fmt.Money(product.RetailerRate) / @product.Unit</small>
                            </div>
                            <button class="btn btn-sm btn-outline-danger" title="Remove" @onclick="() => { lines.Remove(line); }"><Icon Name="trash" Class="sm" /></button>
                        </div>
                        <div class="grid-2">
                            <label class="field">
                                <span class="field-label req">Quantity</span>
                                <input type="number" inputmode="decimal" min="0" step="any" @bind="line.Qty" />
                            </label>
                            <label class="field">
                                <span class="field-label req">Unit</span>
                                <select @bind="line.Unit">
                                    <option value="@UnitKinds.Unit">@product.Unit</option>
                                    @if (!string.IsNullOrWhiteSpace(product.SecondUnit))
                                    {
                                        <option value="@UnitKinds.Second">@($"{product.SecondUnit} ({Fmt.Qty(product.ConvFactor)} {product.Unit})")</option>
                                    }
                                </select>
                            </label>
                        </div>
                        @if (schemes.Count > 0)
                        {
                            <label class="field mt-1">
                                <span class="field-label">Scheme</span>
                                <select @bind="line.SchemeId">
                                    <option value="">No scheme</option>
                                    @foreach (var s in schemes)
                                    {
                                        <option value="@s.Id">@SchemeText(s, product)</option>
                                    }
                                </select>
                            </label>
                        }
                        <div class="line-calc">
                            <span>@Fmt.Qty(calc.BaseQty) @product.Unit &times; @Fmt.Money(calc.Rate)</span>
                            @if (calc.Discount > 0)
                            {
                                <span class="disc">&minus; @Fmt.Money(calc.Discount) discount</span>
                            }
                            @if (calc.FreeQty > 0)
                            {
                                <span class="free">+ @Fmt.Qty(calc.FreeQty) @product.Unit free</span>
                            }
                            <span class="amount">NPR @Fmt.Money(calc.LineValue)</span>
                        </div>
                        @if (!string.IsNullOrEmpty(line.SchemeId) && !calc.SchemeApplied)
                        {
                            <Alert Kind="warning" Class="compact mt-1">This scheme does not apply. Check the minimum quantity, or choose "No scheme".</Alert>
                        }
                    </div>
                }

                <div class="add-product">
                    <div class="section-title mt-0"><Icon Name="plus" Class="sm" /> Add product</div>
                    @if (BrandsWithProducts.Count > 1)
                    {
                        <div class="import-filters brand-chips">
                            <button type="button" class='chip @(brandFilter == "" ? "active" : "")' @onclick='() => { brandFilter = ""; addProductId = ""; }'>All brands</button>
                            @foreach (var b in BrandsWithProducts)
                            {
                                <button type="button" class='chip @(brandFilter == b.Id ? "active" : "")' @onclick="() => { brandFilter = b.Id; addProductId = string.Empty; }">@b.Name</button>
                            }
                        </div>
                    }
                    <div class="form-grid cols-2">
                        <div class="input-icon">
                            <Icon Name="search" />
                            <input placeholder="Search name or code" @bind="productFilter" @bind:event="oninput" />
                        </div>
                        <select @bind="addProductId" @bind:after="AddSelectedProduct">
                            <option value="">@AddProductPrompt</option>
                            @foreach (var p in FilteredProducts)
                            {
                                <option value="@p.Id">@p.Code - @p.Name</option>
                            }
                        </select>
                    </div>
                </div>

                @if (lines.Count == 0)
                {
                    <label class="field mt-2">
                        <span class="field-label req">No order? Reason</span>
                        <textarea maxlength="200" @bind="reason" placeholder="e.g. Shop closed, enough stock, owner not available"></textarea>
                        <span class="hint">Required when the party does not order.</span>
                    </label>
                }
                else
                {
                    <div class="total-bar">
                        <span>Order total</span>
                        <b>NPR @Fmt.Money(OrderTotal)</b>
                    </div>
                }

                <Alert Kind="error" Message="@formError" Class="mt-2" />

                <button class="btn btn-primary btn-lg btn-block mt-2" disabled="@(saving || !attOk || boot.Beats.Count == 0)" @onclick="SaveAsync">
                    @if (saving)
                    {
                        <span class="spinner"></span>
                        <span>Saving...</span>
                    }
                    else if (lines.Count > 0)
                    {
                        <Icon Name="check" />
                        <span>Save order</span>
                    }
                    else
                    {
                        <Icon Name="check" />
                        <span>Save visit (no order)</span>
                    }
                </button>
                @if (!attOk)
                {
                    <p class="muted small mt-1 mb-0" style="text-align:center">Mark attendance first to save visits.</p>
                }
            </div>
        </div>
    }
    else if (string.IsNullOrEmpty(loadError))
    {
        <div class="card"><div class="loading"><span class="spinner"></span> Loading your beats and products...</div></div>
    }
</RoleGuard>

@code {
    private sealed class LineModel
    {
        public string ProductId { get; set; } = "";
        public decimal Qty { get; set; } = 1;
        public string Unit { get; set; } = UnitKinds.Unit;
        public string SchemeId { get; set; } = "";
    }

    private SalesBootstrap? boot;
    private string? loadError;
    private bool offlineData;

    private bool attOk;
    private bool attBusy;
    private string attStatus = "";
    private string? attError;

    private string beatId = "";
    private string partyId = "";
    private string reason = "";
    private string productFilter = "";
    private string brandFilter = "";
    private string addProductId = "";
    private readonly List<LineModel> lines = new();
    private bool saving;
    private string? formError;

    private List<QueuedRecord> queue = new();
    private List<VisitResult> results = new();

    private string SubtitleText => boot == null
        ? "Record each shop visit and order."
        : string.IsNullOrEmpty(boot.DealerName) ? boot.UserName : $"{boot.UserName} · {boot.DealerName}";

    private string AddProductPrompt
    {
        get
        {
            var count = FilteredProducts.Count();
            if (count == 0) return "No matching products";
            return productFilter.Trim().Length > 0 || brandFilter.Length > 0 ? $"Select from {count} product(s)" : "Select a product to add";
        }
    }

    private IEnumerable<Party> PartiesInBeat =>
        boot == null || string.IsNullOrEmpty(beatId) ? Enumerable.Empty<Party>() : boot.Parties.Where(p => p.BeatId == beatId);

    private Party? SelectedParty => boot?.Parties.FirstOrDefault(p => p.Id == partyId);

    /// <summary>Active brands that have at least one product (chips on the order screen).</summary>
    private List<Brand> BrandsWithProducts =>
        boot == null ? new List<Brand>()
        : boot.Brands.Where(b => boot.Products.Any(p => p.BrandId == b.Id)).ToList();

    private IEnumerable<Product> FilteredProducts
    {
        get
        {
            if (boot == null) return Enumerable.Empty<Product>();
            var f = productFilter.Trim();
            var list = boot.Products.AsEnumerable();
            if (brandFilter.Length > 0) list = list.Where(p => p.BrandId == brandFilter);
            if (f.Length > 0)
                list = list.Where(p => p.Name.Contains(f, StringComparison.OrdinalIgnoreCase) || p.Code.Contains(f, StringComparison.OrdinalIgnoreCase));
            return list.Take(200);
        }
    }

    private static string SchemeText(Scheme s, Product product)
    {
        var text = $"{s.Name} ({SchemeTypes.Label(s.Type)}: {Fmt.Qty(s.Value)}";
        if (s.MinQty > 0) text += $", min {Fmt.Qty(s.MinQty)} {product.Unit}";
        return text + ")";
    }

    private Product? ProductOf(LineModel line) => boot?.Products.FirstOrDefault(p => p.Id == line.ProductId);

    private List<Scheme> SchemesFor(Product product)
    {
        if (boot == null) return new List<Scheme>();
        var today = Fmt.Today();
        return boot.Schemes.Where(s => s.IsActive && s.ProductId == product.Id && s.StartDate <= today && s.EndDate >= today).ToList();
    }

    private LineCalc Calc(LineModel line, Product product)
    {
        var scheme = boot?.Schemes.FirstOrDefault(s => s.Id == line.SchemeId);
        return Pricing.Calculate(product, line.Qty, line.Unit, scheme, Fmt.Today());
    }

    private decimal OrderTotal => lines.Sum(l => ProductOf(l) is { } p ? Calc(l, p).LineValue : 0);

    protected override async Task OnInitializedAsync()
    {
        if (!Auth.IsLoggedIn || Auth.Role != Roles.Sales || Auth.MustChangePassword) return;
        Sync.Changed += OnSyncChanged;
        Tracking.Changed += OnTrackingChanged;
        await Tracking.ResumeAsync();
        await LoadBootAsync();
        await RefreshQueueAsync();
        await EnsureAttendanceAsync();
        _ = SyncNowAsync();
    }

    private async Task LoadBootAsync()
    {
        loadError = null;
        try
        {
            boot = await Api.GetAsync<SalesBootstrap>("api/sales/bootstrap");
            await MergeQueuedPartiesAsync();
            await Sync.SaveBootstrapAsync(boot);
            offlineData = false;
        }
        catch (ApiException ex) when (ex.IsTransient)
        {
            boot = await Sync.GetCachedBootstrapAsync();
            offlineData = boot != null;
            if (boot == null)
                loadError = "No connection and no saved data on this phone. Connect to the internet once to load your beats and products.";
        }
        catch (ApiException ex)
        {
            loadError = ex.Message;
        }

        if (boot != null && boot.Beats.Count == 1) beatId = boot.Beats[0].Id;
    }

    private async Task EnsureAttendanceAsync()
    {
        var today = Fmt.Today();
        if (boot != null && boot.AttendanceMarkedToday && boot.Today == today)
        {
            attOk = true;
            attStatus = $"{boot.AttendanceTime} · {boot.AttendanceLocation}";
            await Sync.SetLocalAttendanceDateAsync(today);
            return;
        }
        if (await Sync.GetLocalAttendanceDateAsync() == Fmt.Date(today))
        {
            attOk = true;
            attStatus = "Captured on this phone today.";
            return;
        }
        await CaptureAttendanceAsync();
    }

    private async Task CaptureAttendanceAsync()
    {
        attBusy = true;
        attError = null;
        StateHasChanged();
        try
        {
            var geo = await Browser.GetLocationAsync();
            if (!geo.Ok)
            {
                attError = geo.Error ?? "Could not get your location.";
                return;
            }

            var req = new AttendanceRequest
            {
                Id = Guid.NewGuid().ToString("N"),
                CapturedAt = Fmt.LocalNow(),
                Lat = geo.Lat,
                Lng = geo.Lng
            };
            await Sync.EnqueueAsync(OfflineSync.KindAttendance, req.Id, req, $"Attendance {req.CapturedAt:yyyy-MM-dd HH:mm}");
            await Sync.SetLocalAttendanceDateAsync(Fmt.Today());
            attOk = true;
            attStatus = $"Marked at {req.CapturedAt:HH:mm}.";
            Toast.Success($"Attendance marked at {req.CapturedAt:HH:mm}.", "Good morning");
            _ = SyncNowAsync();
        }
        catch (Exception ex)
        {
            attError = ex.Message;
        }
        finally
        {
            attBusy = false;
        }
    }

    private void OnBeatChanged()
    {
        partyId = "";
    }

    private void AddSelectedProduct()
    {
        if (string.IsNullOrEmpty(addProductId)) return;
        var product = boot?.Products.FirstOrDefault(p => p.Id == addProductId);
        if (product != null)
        {
            lines.Add(new LineModel { ProductId = product.Id, Qty = 1, Unit = UnitKinds.Unit });
        }
        addProductId = "";
        productFilter = "";
    }

    private async Task SaveAsync()
    {
        formError = null;
        if (boot == null) return;

        if (string.IsNullOrEmpty(beatId)) { formError = "Select a beat."; return; }
        if (string.IsNullOrEmpty(partyId)) { formError = "Select a party."; return; }

        foreach (var l in lines)
        {
            var p = ProductOf(l);
            if (p == null) { formError = "A product in the order is no longer available. Remove it."; return; }
            if (l.Qty <= 0) { formError = $"Enter a quantity for {p.Name}."; return; }
            if (!string.IsNullOrEmpty(l.SchemeId) && !Calc(l, p).SchemeApplied)
            {
                formError = $"The scheme selected for {p.Name} does not apply. Change the quantity or choose \"No scheme\".";
                return;
            }
        }
        if (lines.Count == 0 && reason.Trim().Length < 3)
        {
            formError = "Enter a reason for no order (at least 3 characters).";
            return;
        }

        saving = true;
        try
        {
            var geo = await Browser.GetLocationAsync();
            if (!geo.Ok)
            {
                formError = geo.Error ?? "Could not get your location.";
                return;
            }

            var party = SelectedParty;

            // Location check (Master Settings): must be at the shop. The server checks again.
            if (party != null)
            {
                var problem = Geo.CheckAtShop(geo.Lat, geo.Lng, geo.Accuracy, party.Lat, party.Lng, party.Name,
                                              boot.VisitRadiusM, boot.MaxGpsAccuracyM);
                if (problem != null)
                {
                    formError = problem;
                    return;
                }
            }

            var total = OrderTotal;
            var req = new VisitRequest
            {
                Id = Guid.NewGuid().ToString("N"),
                CapturedAt = Fmt.LocalNow(),
                BeatId = beatId,
                PartyId = partyId,
                Lat = geo.Lat,
                Lng = geo.Lng,
                Accuracy = Math.Round(geo.Accuracy),
                NoOrderReason = lines.Count == 0 ? reason.Trim() : "",
                Items = lines.Select(l => new OrderLineRequest
                {
                    ProductId = l.ProductId,
                    Qty = l.Qty,
                    Unit = l.Unit,
                    SchemeId = l.SchemeId
                }).ToList()
            };
            var label = $"{party?.Name} - " + (lines.Count > 0 ? $"order NPR {Fmt.Money(total)}" : "no order");

            await Sync.EnqueueAsync(OfflineSync.KindVisit, req.Id, req, label);

            // First visit of a shop without GPS: the server saves this location for the shop; keep it on the phone too.
            if (party != null && (party.Lat == null || party.Lng == null))
            {
                party.Lat = Math.Round(geo.Lat, 6);
                party.Lng = Math.Round(geo.Lng, 6);
                await Sync.SaveBootstrapAsync(boot);
            }

            lines.Clear();
            reason = "";
            partyId = "";
            StateHasChanged();

            await SyncNowAsync();
            var sent = (await Sync.GetQueueAsync()).All(q => q.Id != req.Id);
            if (sent)
            {
                if (req.Items.Count > 0) Toast.Success($"Order for {party?.Name} saved. Share it on WhatsApp.", "Order saved");
                else Toast.Success($"Visit to {party?.Name} saved.", "Visit saved");
            }
            else
            {
                Toast.Warning("Saved on this phone. It will be sent automatically when the connection returns.", "Saved offline");
            }
        }
        catch (Exception ex)
        {
            formError = ex.Message;
        }
        finally
        {
            saving = false;
        }
    }

    private async Task SyncNowAsync()
    {
        await Sync.SyncAsync();
        await RefreshQueueAsync();
        StateHasChanged();
    }

    private async Task RefreshQueueAsync()
    {
        queue = await Sync.GetQueueAsync();
        results = await Sync.GetResultsAsync();
    }

    private async Task RetryAsync(string id)
    {
        await Sync.RetryAsync(id);
        await RefreshQueueAsync();
    }

    private async Task RemoveQueuedAsync(QueuedRecord q)
    {
        var ok = await Confirm.AskAsync("Remove this record?", $"\"{q.Label}\" will not be sent. Enter the visit again if needed.", "Remove", danger: true);
        if (!ok) return;
        await Sync.RemoveAsync(q.Id);
        await RefreshQueueAsync();
        Toast.Info("Record removed.");
    }

    private async Task ShareAsync(VisitResult r)
    {
        await Browser.OpenUrlAsync("https://wa.me/?text=" + Uri.EscapeDataString(r.WhatsAppText));
    }

    private async Task DismissAsync(VisitResult r)
    {
        await Sync.MarkSharedAsync(r.VisitId);
        await RefreshQueueAsync();
    }

    private void OnSyncChanged()
    {
        _ = InvokeAsync(async () =>
        {
            await RefreshQueueAsync();
            StateHasChanged();
        });
    }

    // ------------------------------------------------------------------ New party (shop)

    private NewPartyRequest? newParty;
    private bool partyBusy;
    private bool dupWarning;
    private string dupName = "";
    private string? partyError;

    private string BeatName(string id) => boot?.Beats.FirstOrDefault(b => b.Id == id)?.Name ?? "";

    /// <summary>New shops still waiting to be sent are not in the server's list yet: keep them selectable.</summary>
    private async Task MergeQueuedPartiesAsync()
    {
        if (boot == null) return;
        var opts = new System.Text.Json.JsonSerializerOptions(System.Text.Json.JsonSerializerDefaults.Web);
        foreach (var q in (await Sync.GetQueueAsync()).Where(q => q.Kind == OfflineSync.KindParty))
        {
            var req = System.Text.Json.JsonSerializer.Deserialize<NewPartyRequest>(q.Json, opts);
            if (req == null || boot.Parties.Any(p => p.Id == req.Id)) continue;
            boot.Parties.Add(new Party
            {
                Id = req.Id,
                Name = req.Name,
                PartyTypeId = req.PartyTypeId,
                BeatId = req.BeatId,
                ContactPerson = req.ContactPerson,
                Phone = req.Phone,
                Address = req.Address,
                Lat = req.Lat,
                Lng = req.Lng,
                AddedByUserId = Auth.UserId,
                NeedsReview = true,
                IsActive = true
            });
        }
        boot.Parties = boot.Parties.OrderBy(p => p.Name).ToList();
    }

    private void OpenNewParty()
    {
        if (boot == null || string.IsNullOrEmpty(beatId)) return;
        dupWarning = false;
        dupName = "";
        partyError = null;
        newParty = new NewPartyRequest
        {
            Id = Guid.NewGuid().ToString("N"),
            BeatId = beatId,
            PartyTypeId = boot.PartyTypes.Count == 1 ? boot.PartyTypes[0].Id : ""
        };
    }

    private void CloseNewParty()
    {
        newParty = null;
        dupWarning = false;
    }

    private async Task SaveNewPartyAsync()
    {
        if (boot == null || newParty == null) return;
        var name = newParty.Name.Trim();
        var duplicate = boot.Parties.Any(p => p.BeatId == newParty.BeatId && string.Equals(p.Name.Trim(), name, StringComparison.OrdinalIgnoreCase));
        if (duplicate && !string.Equals(dupName, name, StringComparison.OrdinalIgnoreCase))
        {
            // First attempt with this name: warn; a second tap on "Add anyway" saves it.
            dupWarning = true;
            dupName = name;
            return;
        }

        partyBusy = true;
        partyError = null;
        try
        {
            // GPS: required while the location check is on (Master Settings), otherwise optional.
            var geo = await Browser.GetLocationAsync();
            if (boot.VisitRadiusM > 0)
            {
                // Location check on: the shop is saved where you stand, so a good GPS fix is required.
                if (!geo.Ok)
                {
                    partyError = (geo.Error ?? "Could not get your location.") + " Turn on location (GPS), stand at the shop and try again.";
                    return;
                }
                if (geo.Accuracy > boot.MaxGpsAccuracyM)
                {
                    partyError = $"Your GPS is not accurate enough (about {geo.Accuracy:0} m; {boot.MaxGpsAccuracyM} m or better is needed). Step outside near the shop, wait a few seconds and try again.";
                    return;
                }
            }
            if (geo.Ok)
            {
                newParty.Lat = geo.Lat;
                newParty.Lng = geo.Lng;
                newParty.Accuracy = Math.Round(geo.Accuracy);
            }
            newParty.Name = name;

            // Saved on the phone first (works offline); sent before the visit that uses it.
            await Sync.EnqueueAsync(OfflineSync.KindParty, newParty.Id, newParty, $"New shop: {name}");

            var party = new Party
            {
                Id = newParty.Id,
                Name = name,
                PartyTypeId = newParty.PartyTypeId,
                BeatId = newParty.BeatId,
                ContactPerson = newParty.ContactPerson.Trim(),
                Phone = newParty.Phone.Trim(),
                Address = newParty.Address.Trim(),
                Lat = newParty.Lat,
                Lng = newParty.Lng,
                AddedByUserId = Auth.UserId,
                NeedsReview = true,
                IsActive = true
            };
            boot.Parties.Add(party);
            boot.Parties = boot.Parties.OrderBy(p => p.Name).ToList();
            await Sync.SaveBootstrapAsync(boot);

            partyId = party.Id;
            newParty = null;
            dupWarning = false;
            Toast.Success($"{name} is added and selected for this visit.", "Shop added");
            _ = SyncNowAsync();
        }
        catch (Exception ex)
        {
            Toast.Error(ex.Message, "Could not add the shop");
        }
        finally
        {
            partyBusy = false;
        }
    }

    // ------------------------------------------------------------------ Beat tracking

    private bool trackBusy;

    private async Task StartBeatAsync()
    {
        if (boot == null || boot.Beats.Count == 0) return;
        if (!await Tracking.HasConsentAsync())
        {
            var agreed = await Confirm.AskAsync("Start beat tracking?",
                "While tracking is on, your location is recorded about every minute and shown to the office, until you tap End beat. It is not recorded at any other time.",
                "I agree, start");
            if (!agreed) return;
            await Tracking.SaveConsentAsync();
        }

        trackBusy = true;
        try
        {
            var beat = string.IsNullOrEmpty(beatId) ? boot.Beats[0].Id : beatId;
            var err = await Tracking.StartAsync(beat);
            if (err != null) Toast.Error(err, "Could not start tracking");
            else Toast.Success("Your route is being recorded. Keep this app open.", "Beat started");
        }
        finally
        {
            trackBusy = false;
        }
    }

    private async Task EndBeatAsync()
    {
        var ok = await Confirm.AskAsync("End beat?", "Location tracking will stop. You can start again later today if needed.", "End beat");
        if (!ok) return;
        trackBusy = true;
        try
        {
            await Tracking.StopAsync();
            Toast.Info("Beat ended. Tracking is off.");
        }
        finally
        {
            trackBusy = false;
        }
    }

    private void OnTrackingChanged() => _ = InvokeAsync(StateHasChanged);

    public void Dispose()
    {
        Sync.Changed -= OnSyncChanged;
        Tracking.Changed -= OnTrackingChanged;
    }
}