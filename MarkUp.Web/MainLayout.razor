@inherits LayoutComponentBase
@implements IDisposable
@inject AuthSession Auth
@inject NavigationManager Nav
@inject OfflineSync Sync
@inject Browser Browser
@inject ConfirmService Confirm
@inject ApiClient Api
@inject TrackingClient Tracking
@inject ToastService Toast

@if (Auth.IsLoggedIn && !Auth.MustChangePassword)
{
    <div class='shell @(menuOpen ? "menu-open" : "")'>
        <aside class="sidebar">
            <div class="sidebar-brand">
                <img src="icons/icon-192.png" alt="" />
                <div>
                    <b>MARK_UP</b>
                    <small>Sales &amp; Billing</small>
                </div>
                <button class="btn btn-ghost btn-icon sidebar-close" aria-label="Close menu" @onclick="CloseMenu"><Icon Name="x" /></button>
            </div>

            <nav class="sidebar-nav">
                <div class="nav-section">Main</div>
                @if (Auth.Role == Roles.Admin)
                {
                    <NavLink class="nav-item" href="admin" Match="NavLinkMatch.All"><Icon Name="dashboard" /><span>Dashboard</span></NavLink>
                    <NavLink class="nav-item" href="admin/attendance"><Icon Name="clock" /><span>Attendance</span></NavLink>
                }
                @if (Auth.Role == Roles.Sales)
                {
                    <NavLink class="nav-item" href="sales"><Icon Name="map-pin" /><span>Market Visit</span></NavLink>
                }
                @if (Auth.IsInRole(Roles.Admin, Roles.Bill))
                {
                    <NavLink class="nav-item" href="billing"><Icon Name="receipt" /><span>Orders &amp; Billing</span></NavLink>
                }
                @if (Auth.Role == Roles.Admin)
                {
                    <NavLink class="nav-item" href="admin/live-map"><Icon Name="map" /><span>Live Map</span></NavLink>
                }
                <NavLink class="nav-item" href="reports"><Icon Name="chart" /><span>Reports</span></NavLink>

                @if (Auth.Role == Roles.Admin)
                {
                    <div class="nav-section">Masters</div>
                    <NavLink class="nav-item" href="admin/users"><Icon Name="users" /><span>Users</span></NavLink>
                    <NavLink class="nav-item" href="admin/dealers"><Icon Name="building" /><span>Dealers</span></NavLink>
                    <NavLink class="nav-item" href="admin/beats"><Icon Name="route" /><span>Beats</span></NavLink>
                    <NavLink class="nav-item" href="admin/parties"><Icon Name="store" /><span>Parties</span></NavLink>
                    <NavLink class="nav-item" href="admin/brands"><Icon Name="layers" /><span>Brands</span></NavLink>
                    <NavLink class="nav-item" href="admin/products"><Icon Name="package" /><span>Products</span></NavLink>
                    <NavLink class="nav-item" href="admin/schemes"><Icon Name="tag" /><span>Schemes</span></NavLink>
                    <NavLink class="nav-item" href="admin/targets"><Icon Name="target" /><span>Targets</span></NavLink>
                    <NavLink class="nav-item" href="admin/settings"><Icon Name="settings" /><span>Master Settings</span></NavLink>
                }

                <div class="nav-section">Account</div>
                <NavLink class="nav-item" href="profile"><Icon Name="user" /><span>My Profile</span></NavLink>
                <NavLink class="nav-item" href="change-password"><Icon Name="key" /><span>Change Password</span></NavLink>
            </nav>

            <div class="sidebar-user">
                <a class="sidebar-user-link" href="profile" title="My Profile">
                    <Avatar Photo="@Auth.Photo" Name="@Auth.Name" />
                    <div class="who">
                        <b>@Auth.Name</b>
                        <small>@RoleLabel</small>
                    </div>
                </a>
                <button class="btn btn-ghost btn-icon" title="Log out" aria-label="Log out" @onclick="LogoutAsync"><Icon Name="logout" /></button>
            </div>
        </aside>

        <div class="backdrop" @onclick="CloseMenu"></div>

        <div class="main">
            <header class="topbar">
                <button class="btn btn-ghost btn-icon menu-btn" aria-label="Open menu" @onclick="OpenMenu"><Icon Name="menu" /></button>
                <span class="topbar-title">MARK_UP</span>
                <span class="spacer"></span>
                @if (!online)
                {
                    <span class="badge badge-warning">Offline</span>
                }
                @if (Tracking.IsTracking)
                {
                    <a class="badge badge-success track-badge" href="sales" title="Beat tracking is on"><span class="pulse-dot sm"></span> Tracking</a>
                }
                <span class="badge badge-role-@Auth.Role no-dot">@RoleLabel</span>
                <a class="topbar-user" href="profile" title="My Profile">
                    <div class="who">
                        <b>@Auth.Name</b>
                    </div>
                    <Avatar Photo="@Auth.Photo" Name="@Auth.Name" Class="light" />
                </a>
            </header>

            @if (!online)
            {
                <div class="offline-bar">
                    <Icon Name="wifi-off" Class="sm" />
                    You are offline. Saved visits will be sent automatically when the connection returns.
                </div>
            }

            <main class="content">
                @Body
            </main>
        </div>
    </div>
}
else
{
    <main>
        @Body
    </main>
}

<Toasts />
<ConfirmHost />

@code {
    private bool online = true;
    private string photoUserId = "";
    private bool menuOpen;
    private DotNetObjectReference<MainLayout>? selfRef;
    private Timer? timer;
    private string attendanceCheckedFor = "";

    private string RoleLabel => Auth.Role switch
    {
        Roles.Sales => "Salesperson",
        Roles.Bill => "Billing",
        Roles.Admin => "Administrator",
        _ => Auth.Role
    };

    protected override void OnInitialized()
    {
        Auth.Changed += OnAuthChanged;
        Nav.LocationChanged += OnLocationChanged;
        Tracking.Changed += OnTrackingChanged;
    }

    private void OnTrackingChanged() => _ = InvokeAsync(StateHasChanged);

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;

        online = await Browser.IsOnlineAsync();
        selfRef = DotNetObjectReference.Create(this);
        await Browser.RegisterOnlineAsync(selfRef);

        // Try to send waiting records every minute.
        timer = new Timer(_ => InvokeAsync(TickAsync), null, TimeSpan.FromSeconds(20), TimeSpan.FromSeconds(60));
        StateHasChanged();
        await LoadPhotoAsync();
        await Tracking.ResumeAsync();
        await EnsureBillAttendanceAsync();

    }
    /// <summary>
    /// Billing staff: the first sign-in of the day records attendance (time + GPS).
    /// If location is refused or unavailable the time is still recorded as "No GPS".
    /// Offline: nothing is saved and it is tried again on the next minute tick.
    /// </summary>
    private async Task EnsureBillAttendanceAsync()
    {
        if (!Auth.IsLoggedIn || Auth.MustChangePassword || Auth.Role != Roles.Bill) return;
        var today = Fmt.Date(Fmt.Today());
        var key = Auth.UserId + "|" + today;
        if (attendanceCheckedFor == key) return;
        attendanceCheckedFor = key; // stops a second check starting while this one runs

        try
        {
            if (await Sync.GetLocalAttendanceDateAsync() == today) return;

            var me = await Api.GetAsync<AttendanceResult>("api/attendance/me");
            if (me.AlreadyMarked)
            {
                await Sync.SetLocalAttendanceDateAsync(me.Date);
                return;
            }

            var capturedAt = Fmt.LocalNow();
            GeoResult geo;
            try
            {
                geo = await Browser.GetLocationAsync();
            }
            catch (Exception)
            {
                geo = new GeoResult { Ok = false };
            }

            var req = new AttendanceRequest
            {
                Id = Guid.NewGuid().ToString("N"),
                CapturedAt = capturedAt,
                Lat = geo.Ok ? geo.Lat : 0,
                Lng = geo.Ok ? geo.Lng : 0,
                NoGps = !geo.Ok
            };
            var res = await Api.PostAsync<AttendanceResult>("api/attendance", req);
            await Sync.SetLocalAttendanceDateAsync(res.Date);
            if (!res.AlreadyMarked)
            {
                Toast.Success(res.NoGps
                    ? $"Attendance marked at {res.LoginTime} without location (location was not allowed)."
                    : $"Attendance marked at {res.LoginTime}.", "Good morning");
            }
        }
        catch (Exception)
        {
            attendanceCheckedFor = ""; // e.g. offline: try again on the next tick
        }
    }

    /// <summary>Loads the signed-in user's profile picture once per sign-in (shown in the menu).</summary>
    private async Task LoadPhotoAsync()
    {
        if (!Auth.IsLoggedIn || Auth.MustChangePassword || photoUserId == Auth.UserId) return;
        photoUserId = Auth.UserId;
        try
        {
            var profile = await Api.GetAsync<ProfileView>("api/profile/me");
            Auth.SetPhoto(profile.Photo);
        }
        catch (Exception)
        {
            photoUserId = ""; // e.g. offline: try again on the next change
        }
    }

    private async Task TickAsync()
    {
        var now = await Browser.IsOnlineAsync();
        if (now != online)
        {
            online = now;
            StateHasChanged();
        }
        if (online && Auth.Role == Roles.Sales) await Sync.SyncAsync();
        if (online) await EnsureBillAttendanceAsync();
    }

    [JSInvokable]
    public async Task OnOnline()
    {
        online = true;
        StateHasChanged();
        if (Auth.Role == Roles.Sales) await Sync.SyncAsync();
        await EnsureBillAttendanceAsync();
    }

    private void OpenMenu() => menuOpen = true;

    private void CloseMenu() => menuOpen = false;

    private void OnLocationChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e)
    {
        if (!menuOpen) return;
        menuOpen = false;
        _ = InvokeAsync(StateHasChanged);
    }

    private async Task LogoutAsync()
    {
        if (Auth.Role == Roles.Sales)
        {
            var waiting = (await Sync.GetQueueAsync()).Count;
            if (waiting > 0 && !await Confirm.AskAsync(
                    "Records not sent yet",
                    $"{waiting} record(s) are still waiting to be sent. They stay safely on this phone and will be sent when you log in again.",
                    "Log out anyway"))
                return;
        }
        else if (!await Confirm.AskAsync("Log out?", "You will need to sign in again to use the app.", "Log out"))
        {
            return;
        }

        menuOpen = false;
        if (Auth.Role == Roles.Sales) await Tracking.SignOutAsync();
        await Auth.ClearAsync();
        Nav.NavigateTo("login", replace: true);
    }

    private void OnAuthChanged() => _ = InvokeAsync(async () =>
    {
        if (!Auth.IsLoggedIn)
        {
            photoUserId = "";
            attendanceCheckedFor = "";
        }
        StateHasChanged();
        await LoadPhotoAsync();
        if (Auth.IsLoggedIn && !Auth.MustChangePassword)
        {
            await Tracking.ResumeAsync();
            await EnsureBillAttendanceAsync();
        }
    });

    public void Dispose()
    {
        Auth.Changed -= OnAuthChanged;
        Tracking.Changed -= OnTrackingChanged;
        Nav.LocationChanged -= OnLocationChanged;
        timer?.Dispose();
        selfRef?.Dispose();
    }
}